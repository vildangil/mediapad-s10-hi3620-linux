# Huawei MediaPad 10 FHD S10-101x / HiSilicon Hi3620 bring-up
#
# Keep this intentionally small. The current milestone is CPU/GIC/timers/UART
# plus SD/eMMC block I/O and a bootloader-framebuffer takeover for the panel.

CONFIG_SYSVIPC=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_BLK_DEV_INITRD=y

CONFIG_ARCH_MULTI_V7=y
# CONFIG_ARCH_MULTI_V5 is not set
# CONFIG_ARCH_MULTI_V4 is not set
CONFIG_ARCH_HISI=y
CONFIG_ARCH_HI3xxx=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# postmarketOS armv7 userspace is ARM EABI5 hard-float and uses VFPv3-D16.
# Without these, PID 1 reaches exec but dies immediately with SIGILL.
CONFIG_AEABI=y
CONFIG_VFP=y

CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536

# postmarketOS initramfs/rootfs needs the networking core for netlink and
# AF_UNIX control sockets used by udevd. Keep IP/packet networking out of the
# tiny bring-up kernel for now so the legacy 8 MiB boot partition still fits.
CONFIG_NET=y
CONFIG_UNIX=y

CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# The bootloader leaves a working 1920x1200 ARGB8888 scanout on EDC0 CH2.
# Register that existing surface as /dev/fb0 without touching display timing
# registers, and use fbcon so kernel/userspace console output can be seen.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y

CONFIG_GPIO_PL061=y

CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_K3=y

CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Persistent early-boot logging. The board DTS reserves the final 1 MiB of
# known-good System RAM for ramoops so a failed boot can be inspected later.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_HI3620_UART=y
CONFIG_EARLY_PRINTK=y
