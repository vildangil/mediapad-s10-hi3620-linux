/*
 * Huawei MediaPad 10 FHD S10-101x hardware bring-up overlay.
 */

#include "hi3620-s10-101x.dts"
#include <dt-bindings/input/input.h>

/ {
	/*
	 * Huawei's CS clock tree sources I2C0 from CFGAXI at 48 MHz.  The old
	 * mainline Hi3620 clock description incorrectly reports pclk/26 MHz for
	 * this gate, causing DesignWare to program the wrong SCL high/low counts.
	 * hi3620-hwfix2.c keeps the real SCTRL gate/reset under board control;
	 * this fixed clock only supplies the correct input rate to the I2C core.
	 */
	i2c0_refclk: i2c0-refclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <48000000>;
	};

	/* Vivante GC4000 integrated in Hi3620/K3V2.  The first-stage helper
	 * supplies the vendor external power/clock/reset sequence.  The second
	 * stage now performs Huawei galcore's missing pre-identify write of 0x900
	 * to HI_CLOCK_CONTROL before Etnaviv probes, so this test can safely ask
	 * the real core for its identity rather than accepting the power-on GC0.
	 */
	gpu: gpu@fa000000 {
		compatible = "vivante,gc";
		reg = <0xfa000000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 32 4>;
		status = "okay";
	};

	gpu-subsystem {
		compatible = "fsl,imx-gpu-subsystem";
		cores = <&gpu>;
	};

	/* Huawei's K3V2 GPIO-key driver documents volume-up on GPIO137
	 * (GPIO17_1) and volume-down on GPIO138 (GPIO17_2), both active-low. */
	gpio-keys {
		compatible = "gpio-keys";

		volume-up {
			label = "Volume Up";
			gpios = <&gpio17 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		volume-down {
			label = "Volume Down";
			gpios = <&gpio17 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/* BQ27510 fuel gauge on K3V2 I2C0.  The controller needs the native mux,
	 * IOCFG electrical settings and the real 48 MHz CFGAXI timing source. */
	i2c0: i2c@fcb08000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb08000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 28 4>;
		clocks = <&i2c0_refclk>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins &i2c0_cfg>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		battery@55 {
			compatible = "ti,bq27510";
			reg = <0x55>;
		};
	};
};

/* Do not replace MMC3's CIU clock with the plain gate clock here.  The base
 * S10 tree intentionally uses HI3620_MMC_CIUCLK3.  hi3620-hwfix2.c changes
 * only MMC3's parent/divider and friend clock before reset; eMMC is untouched. */

&pmx0 {
	/* Important: pinctrl-single's Hi3620 gpio-ranges marks mux value 1 as
	 * GPIO for IOMG45.  Select function 0 so GPIO84/85 are native I2C0. */
	i2c0_pins: i2c0-pins {
		pinctrl-single,pins = <0x0b4 0x0>;
	};
};

&pmx1 {
	/* Exact I2C0 IOCFG settings from the Hi3620/Hi4511 reference board. */
	i2c0_cfg: i2c0-cfg {
		pinctrl-single,pins = <
			0x17c 0	/* I2C0_SCL (IOCFG103) */
			0x180 0	/* I2C0_SDA (IOCFG104) */
		>;
		pinctrl-single,bias-pulldown = <0 2 0 2>;
		pinctrl-single,bias-pullup = <0 1 0 1>;
		pinctrl-single,drive-strength = <0x30 0xf0>;
	};
};
