/*
 * Huawei MediaPad 10 FHD S10-101x hardware bring-up overlay.
 */

#include "hi3620-s10-101x.dts"
#include <dt-bindings/input/input.h>

/ {
	/* Vivante GC4000 integrated in Hi3620/K3V2. Power/clock/reset sequencing
	 * is temporarily handled by hi3620-hwbringup.c. */
	gpu: gpu@fa000000 {
		compatible = "vivante,gc";
		reg = <0xfa000000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 32 4>;
		status = "okay";
	};

	gpu-subsystem {
		compatible = "fsl,imx-gpu-subsystem";
		cores = <&gpu>;
	};

	/* Huawei's K3V2 GPIO-key driver documents volume-up on GPIO137
	 * (GPIO17_1) and volume-down on GPIO138 (GPIO17_2), both active-low. */
	gpio-keys {
		compatible = "gpio-keys";

		volume-up {
			label = "Volume Up";
			gpios = <&gpio17 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		volume-down {
			label = "Volume Down";
			gpios = <&gpio17 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/* BQ27510 fuel gauge on K3V2 I2C0. */
	i2c0: i2c@fcb08000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb08000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 28 4>;
		clocks = <&clock HI3620_I2CCLK0>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		battery@55 {
			compatible = "ti,bq27510";
			reg = <0x55>;
		};
	};
};

/* Use the actual Hi3620 mmc_clk3 chain for BCM4330 SDIO. */
&wifi_sdio {
	clocks = <&clock HI3620_MMC_CLK3>,
		 <&clock HI3620_DDRC_PER_CLK>;
	clock-names = "ciu", "biu";
};

&pmx0 {
	/* GPIO84/GPIO85 are I2C0_SCL/I2C0_SDA on IOMG45, function 1. */
	i2c0_pins: i2c0-pins {
		pinctrl-single,pins = <0x0b4 0x1>;
	};
};
