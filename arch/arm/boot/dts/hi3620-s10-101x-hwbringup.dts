/*
 * Huawei MediaPad 10 FHD S10-101x hardware bring-up overlay.
 */

#include "hi3620-s10-101x.dts"
#include <dt-bindings/input/input.h>

/ {
	/* Huawei CS silicon runs the peripheral CFGAXI domain at 48 MHz. */
	i2c0_refclk: i2c0-refclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <48000000>;
	};

	i2c3_refclk: i2c3-refclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <48000000>;
	};

	/* Vivante GC4000 integrated in Hi3620/K3V2. */
	gpu: gpu@fa000000 {
		compatible = "vivante,gc";
		reg = <0xfa000000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 32 4>;
		status = "okay";
	};

	gpu-subsystem {
		compatible = "fsl,imx-gpu-subsystem";
		cores = <&gpu>;
	};

	/* Huawei's K3V2 GPIO-key driver documents volume-up on GPIO137
	 * (GPIO17_1) and volume-down on GPIO138 (GPIO17_2), both active-low. */
	gpio-keys {
		compatible = "gpio-keys";

		volume-up {
			label = "Volume Up";
			gpios = <&gpio17 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		volume-down {
			label = "Volume Down";
			gpios = <&gpio17 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/* BQ27510 fuel gauge on K3V2 I2C0.  50 kHz gives the old DesignWare
	 * controller extra margin; the physical CFGAXI source is now actually
	 * programmed to the 48 MHz value described by this clock.
	 */
	i2c0: i2c@fcb08000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb08000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 28 4>;
		clocks = <&i2c0_refclk>;
		clock-frequency = <50000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins &i2c0_cfg>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		battery@55 {
			compatible = "ti,bq27510";
			reg = <0x55>;
		};
	};

	/* Huawei S10 vendor kernel enables CONFIG_EXTRAL_DYNAMIC_DCDC and places
	 * a TPS6236x GPU supply at I2C3 address 0x60.  The enable pin is GPIO19
	 * (GPIO2_3).  Keep voltage programming out of this first test: turn on
	 * the physical rail and let the generic TPS driver identify/register it
	 * while preserving the chip's existing VSET value.
	 */
	i2c3: i2c@fcb0d000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb0d000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 63 4>;
		clocks = <&i2c3_refclk>;
		clock-frequency = <50000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c3_pins &i2c3_cfg>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		gpu_dcdc: regulator@60 {
			compatible = "ti,tps62360";
			reg = <0x60>;
			regulator-name = "vcc_gpu_external";
			ti,vsel0-state-high;
		};
	};
};

/* GPIO19 is the external TPS6236x enable used by Huawei's S10 board file. */
&gpio2 {
	gpu-dcdc-enable {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "gpu-dcdc-enable";
	};
};

/* Do not replace MMC3's CIU clock with the plain gate clock here.  The base
 * S10 tree intentionally uses HI3620_MMC_CIUCLK3.  hi3620-hwfix2.c changes
 * only MMC3's parent/divider and friend clock before reset; eMMC is untouched. */

&pmx0 {
	/* GPIO84/85 native I2C0. */
	i2c0_pins: i2c0-pins {
		pinctrl-single,pins = <0x0b4 0x0>;
	};

	/* Vendor CS iomux: GPIO57/58 use IOMG20/21 function 2 for I2C3. */
	i2c3_pins: i2c3-pins {
		pinctrl-single,pins = <
			0x050 0x2
			0x054 0x2
		>;
	};
};

&pmx1 {
	/* Exact I2C0 IOCFG settings from the Hi3620/Hi4511 reference board. */
	i2c0_cfg: i2c0-cfg {
		pinctrl-single,pins = <
			0x17c 0	/* I2C0_SCL (IOCFG103) */
			0x180 0	/* I2C0_SDA (IOCFG104) */
		>;
		pinctrl-single,bias-pulldown = <0 2 0 2>;
		pinctrl-single,bias-pullup = <0 1 0 1>;
		pinctrl-single,drive-strength = <0x30 0xf0>;
	};

	/* IOCG73/74 are GPIO57/58. Huawei's I2C3 normal state uses NOPULL. */
	i2c3_cfg: i2c3-cfg {
		pinctrl-single,pins = <
			0x100 0
			0x104 0
		>;
		pinctrl-single,bias-pulldown = <0 2 0 2>;
		pinctrl-single,bias-pullup = <0 1 0 1>;
	};
};
