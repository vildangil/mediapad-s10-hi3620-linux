/*
 * Huawei MediaPad 10 FHD S10-101x hardware bring-up overlay.
 */

#include "hi3620-s10-101x.dts"
#include <dt-bindings/input/input.h>

/ {
	/* Vivante GC4000 integrated in Hi3620/K3V2. Power/clock/reset sequencing
	 * is temporarily handled by hi3620-hwbringup.c. */
	gpu: gpu@fa000000 {
		compatible = "vivante,gc";
		reg = <0xfa000000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 32 4>;
		status = "okay";
	};

	gpu-subsystem {
		compatible = "fsl,imx-gpu-subsystem";
		cores = <&gpu>;
	};

	/* Huawei's K3V2 GPIO-key driver documents volume-up on GPIO137
	 * (GPIO17_1) and volume-down on GPIO138 (GPIO17_2), both active-low. */
	gpio-keys {
		compatible = "gpio-keys";

		volume-up {
			label = "Volume Up";
			gpios = <&gpio17 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		volume-down {
			label = "Volume Down";
			gpios = <&gpio17 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/* BQ27510 fuel gauge on K3V2 I2C0. */
	i2c0: i2c@fcb08000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb08000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 28 4>;
		clocks = <&clock HI3620_I2CCLK0>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		battery@55 {
			compatible = "ti,bq27510";
			reg = <0x55>;
		};
	};
};

/*
 * Keep the base S10 MMC3 clock wiring here.  In particular, do not replace
 * HI3620_MMC_CIUCLK3 with the plain MMC_CLK3 gate: the CIU wrapper also
 * programs the K3V2 sample/drive/divider timing used by this controller.
 */

/* Match Huawei's BCM4330 WL_REG_ON reset hold before releasing the chip. */
&wifi_pwrseq {
	pre-power-on-delay-ms = <100>;
};

/* Huawei's K3V2 iomux table routes GPIO100..105 to SDIO1 with FUNC1. */
&sdio1_pins {
	pinctrl-single,pins = <
		0x0cc 0x1	/* IOMG51: CLK/CMD/DATA0/DATA2/DATA3 */
		0x0d0 0x1	/* IOMG52: DATA1 */
	>;
};

&wifi_sdio {
	pinctrl-0 = <&sdio1_pins &sdio1_cfg>;
};

&pmx0 {
	/* Important: pinctrl-single's Hi3620 gpio-ranges marks mux value 1 as
	 * GPIO for IOMG45. The previous test accidentally selected that GPIO
	 * function while handing the pins to the DesignWare I2C controller.
	 * Select function 0 here so GPIO84/85 are driven by native I2C0. */
	i2c0_pins: i2c0-pins {
		pinctrl-single,pins = <0x0b4 0x0>;
	};
};

&pmx1 {
	/*
	 * IOCG119..124 are SDIO1 CLK/CMD/DATA0..3.  Use the vendor NORMAL
	 * pulldown/drive setting together with the corrected mux above.
	 */
	sdio1_cfg: sdio1-cfg {
		pinctrl-single,pins = <
			0x1bc 0
			0x1c0 0
			0x1c4 0
			0x1c8 0
			0x1cc 0
			0x1d0 0
		>;
		pinctrl-single,bias-pulldown = <0x2 0x2 0x0 0x3>;
		pinctrl-single,drive-strength = <0x30 0xf0>;
	};
};
