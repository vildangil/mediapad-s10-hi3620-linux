/*
 * Huawei MediaPad 10 FHD S10-101x
 *
 * Initial Linux bring-up device tree for the HiSilicon Hi3620 (K3V2).
 *
 * This is intentionally minimal.  The first milestone is to get a modern
 * kernel through early boot and into an initramfs with useful serial logs.
 * Device-specific MMC, display, touch, Wi-Fi, PMIC and audio nodes should be
 * added only after the base platform is proven on real hardware.
 */

/dts-v1/;

#include "hi3620.dtsi"

/ {
	model = "Huawei MediaPad 10 FHD S10-101x";
	compatible = "huawei,s10-101x", "hisilicon,hi3620";

	chosen {
		/*
		 * Stock cmdline reports console=ttyS0.  The upstream Hi3620 UART is
		 * an ARM PL011 and Linux exposes it as ttyAMA0.
		 */
		bootargs = "console=ttyAMA0,115200n8 earlyprintk ignore_loglevel loglevel=8 root=/dev/ram0 rw";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * The running Huawei kernel exposes 0x00000000..0x34dfffff as System
	 * RAM.  Keep the first bring-up inside that known-good range instead of
	 * guessing the vendor carve-outs in the full 1 GiB physical layout.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x34e00000>;
	};
};

/* SP804 timer already described by hi3620.dtsi. */
&dual_timer0 {
	status = "okay";
};

/*
 * UART0 maps to physical 0xfcb00000 through the AMBA window in
 * hi3620.dtsi.  Do not apply the Hi4511 development-board pinmux here;
 * retaining the bootloader pin setup is safer for the initial test.
 */
&uart0 {
	status = "okay";
};
