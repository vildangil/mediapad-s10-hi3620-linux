/*
 * Huawei MediaPad 10 FHD S10-101x
 *
 * Initial Linux bring-up device tree for the HiSilicon Hi3620 (K3V2).
 */

/dts-v1/;

#include "hi3620.dtsi"

/ {
	model = "Huawei MediaPad 10 FHD S10-101x";
	compatible = "huawei,s10-101x", "hisilicon,hi3620";

	chosen {
		bootargs = "console=ttyAMA0,115200n8 earlyprintk ignore_loglevel loglevel=8 root=/dev/ram0 rw";
		stdout-path = "serial0:115200n8";
	};

	framebuffer0: framebuffer@2f300000 {
		compatible = "simple-framebuffer";
		reg = <0x2f300000 0x008ca000>;
		width = <1920>;
		height = <1200>;
		stride = <7680>;
		format = "a8r8g8b8";
		status = "okay";
	};

	/*
	 * Vendor K3V2 clocks the DesignWare I2C controllers from clk_cfgaxi,
	 * which is 48 MHz on the CS silicon used by this tablet.  The upstream
	 * Hi3620 gate metadata instead reports i2cclk2 as a 26 MHz pclk child.
	 * Keep the real I2C2 gate as the parent, but correct the rate seen by the
	 * DesignWare timing code: 26 MHz * 24 / 13 = 48 MHz.
	 */
	i2c2_timing_clk: i2c2-timing-clock {
		compatible = "fixed-factor-clock";
		clocks = <&clock HI3620_I2CCLK2>;
		#clock-cells = <0>;
		clock-mult = <24>;
		clock-div = <13>;
	};

	usb_otg: usb@fd240000 {
		compatible = "snps,dwc2";
		reg = <0xfd240000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 52 4>;
		clocks = <&clock HI3620_USB2DVC_CLK>;
		clock-names = "otg";
		dr_mode = "peripheral";
		g-rx-fifo-size = <1024>;
		g-np-tx-fifo-size = <512>;
		g-tx-fifo-size = <256 256 256 256 256 256>;
		status = "okay";
	};

	/*
	 * This tablet is the stock I2C2 Synaptics variant.  Keep the alternate
	 * I2C1 controller disabled so it neither changes unused pads nor produces
	 * misleading touch-probe noise.
	 */
	i2c1: i2c@fcb09000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb09000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 29 4>;
		clocks = <&clock HI3620_I2CCLK1>;
		clock-frequency = <100000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	/*
	 * Stock board code places Synaptics RMI4 at 0x70 on physical I2C2.
	 * Hi3620 I2C2 is DesignWare at 0xfcb0c000, GIC SPI62.  GPIO157 is
	 * active-low ATTN and GPIO156 is reset.
	 */
	i2c2: i2c@fcb0c000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb0c000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 62 4>;
		clocks = <&i2c2_timing_clk>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c2_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		touchscreen@70 {
			compatible = "syna,rmi4-i2c";
			reg = <0x70>;
			interrupt-parent = <&gpio19>;
			interrupts = <5 8>;
			syna,startup-delay-ms = <300>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x1ff00000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boottrace@1ff00000 {
			reg = <0x1ff00000 0x00001000>;
		};

		ramoops@1ff01000 {
			compatible = "ramoops";
			reg = <0x1ff01000 0x000ff000>;
			record-size = <0x00040000>;
			console-size = <0x00080000>;
			unbuffered;
		};
	};

	mmc_clock: mmc-clock@fc802000 {
		compatible = "hisilicon,hi3620-mmc-clock";
		reg = <0xfc802000 0x1000>;
		#clock-cells = <1>;
	};

	sd_mmc: mmc@fcd03000 {
		compatible = "hisilicon,hi4511-dw-mshc";
		reg = <0xfcd03000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 16 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&mmc_clock HI3620_SD_CIUCLK>,
			 <&clock HI3620_DDRC_PER_CLK>;
		clock-names = "ciu", "biu";
		num-slots = <1>;
		fifo-depth = <0x100>;
		bus-width = <4>;
		broken-cd;
		disable-wp;
		cap-sd-highspeed;
		status = "okay";
	};

	emmc: mmc@fcd04000 {
		compatible = "hisilicon,hi4511-dw-mshc";
		reg = <0xfcd04000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 17 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&mmc_clock HI3620_MMC_CIUCLK1>,
			 <&clock HI3620_DDRC_PER_CLK>;
		clock-names = "ciu", "biu";
		num-slots = <1>;
		fifo-depth = <0x100>;
		bus-width = <8>;
		non-removable;
		disable-wp;
		cap-mmc-highspeed;
		status = "okay";
	};
};

&pmx0 {
	/*
	 * Important: on Hi3620 the mux encoding is function 0 for I2C2.
	 * The in-tree hi3620-hi4511.dts uses 0 here; function 1 is GPIO/idle.
	 */
	i2c2_pins: i2c2-pins {
		pinctrl-single,pins = <
			0x068 0x0
			0x06c 0x0
		>;
	};
};

&gpio19 {
	/delete-property/ gpio-ranges;

	touch_reset_hog: touch-reset-hog {
		gpio-hog;
		gpios = <4 0>;
		output-high;
		line-name = "touch-reset";
	};
};

&dual_timer0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};
