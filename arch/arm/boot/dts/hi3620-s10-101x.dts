/*
 * Huawei MediaPad 10 FHD S10-101x
 *
 * Initial Linux bring-up device tree for the HiSilicon Hi3620 (K3V2).
 */

/dts-v1/;

#include "hi3620.dtsi"

/ {
	model = "Huawei MediaPad 10 FHD S10-101x";
	compatible = "huawei,s10-101x", "hisilicon,hi3620";

	chosen {
		/*
		 * Stock cmdline reports console=ttyS0.  The upstream Hi3620 UART is
		 * an ARM PL011 and Linux exposes it as ttyAMA0.
		 */
		bootargs = "console=ttyAMA0,115200n8 earlyprintk ignore_loglevel loglevel=8 root=/dev/ram0 rw";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * The Huawei bootloader leaves EDC0 channel 2 scanning out this
	 * surface.  Read-only register snapshots from the stock-established
	 * pipeline show, unchanged from early_init through late_init:
	 *
	 *   CH2_ADDR   = 0x2f300000
	 *   CH2_STRIDE = 0x00001e00 (7680 = 1920 * 4)
	 *   CH2_SIZE   = 0x077f04af (1919,1199 => 1920x1200)
	 *   CH2_CTL    = 0x00230000 (enabled, ARGB8888, RGB order)
	 */
	framebuffer0: framebuffer@2f300000 {
		compatible = "simple-framebuffer";
		reg = <0x2f300000 0x008ca000>;
		width = <1920>;
		height = <1200>;
		stride = <7680>;
		format = "a8r8g8b8";
		status = "okay";
	};

	/*
	 * Huawei's Android kernel exposes the USB device/OTG controller as a
	 * Synopsys DesignWare HS OTG core at 0xfd240000 with GIC SPI 52.  The
	 * MediaPad-specific arch helper reproduces Huawei's PicoPHY reset,
	 * clock and VBUS/ID programming before generic DWC2 probes the core.
	 *
	 * This core reports 3968 FIFO words. Linux 4.9's legacy gadget defaults
	 * exceed that and trigger "insufficient fifo memory" when RNDIS binds.
	 * Use a conservative dedicated-FIFO layout totalling 3072 words.
	 */
	usb_otg: usb@fd240000 {
		compatible = "snps,dwc2";
		reg = <0xfd240000 0x00040000>;
		interrupt-parent = <&gic>;
		interrupts = <0 52 4>;
		clocks = <&clock HI3620_USB2DVC_CLK>;
		clock-names = "otg";
		dr_mode = "peripheral";
		g-rx-fifo-size = <1024>;
		g-np-tx-fifo-size = <512>;
		g-tx-fifo-size = <256 256 256 256 256 256>;
		status = "okay";
	};

	/*
	 * Keep I2C1 described for later board bring-up, but the current tablet
	 * has now been electrically narrowed down to the stock I2C2 path.  Do
	 * not instantiate a second fake RMI client here: it only creates probe
	 * noise and cannot be the touchscreen on this unit.
	 */
	i2c1: i2c@fcb09000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb09000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 29 4>;
		clocks = <&clock HI3620_I2CCLK1>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};

	/*
	 * Stock board code places the Synaptics RMI4 touchscreen on I2C2.
	 * Hi3620 I2C2 is a Synopsys DesignWare master at 0xfcb0c000, GIC SPI
	 * 62. The stock touchscreen uses address 0x70 and attention on GPIO157
	 * (GPIO19 pin 5, active low). GPIO156 is reset.
	 */
	i2c2: i2c@fcb0c000 {
		compatible = "snps,designware-i2c";
		reg = <0xfcb0c000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 62 4>;
		clocks = <&clock HI3620_I2CCLK2>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c2_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		touchscreen@70 {
			compatible = "syna,rmi4-i2c";
			reg = <0x70>;
			interrupt-parent = <&gpio19>;
			interrupts = <5 8>;
			syna,startup-delay-ms = <100>;
		};
	};

	/* Match Huawei's stock mem=511M split so Linux cannot allocate the
	 * bootloader-owned multimedia/display carveout above 0x20000000.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x1ff00000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boottrace@1ff00000 {
			reg = <0x1ff00000 0x00001000>;
		};

		ramoops@1ff01000 {
			compatible = "ramoops";
			reg = <0x1ff01000 0x000ff000>;
			record-size = <0x00040000>;
			console-size = <0x00080000>;
			unbuffered;
		};
	};

	mmc_clock: mmc-clock@fc802000 {
		compatible = "hisilicon,hi3620-mmc-clock";
		reg = <0xfc802000 0x1000>;
		#clock-cells = <1>;
	};

	sd_mmc: mmc@fcd03000 {
		compatible = "hisilicon,hi4511-dw-mshc";
		reg = <0xfcd03000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 16 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&mmc_clock HI3620_SD_CIUCLK>,
			 <&clock HI3620_DDRC_PER_CLK>;
		clock-names = "ciu", "biu";
		num-slots = <1>;
		fifo-depth = <0x100>;
		bus-width = <4>;
		broken-cd;
		disable-wp;
		cap-sd-highspeed;
		status = "okay";
	};

	emmc: mmc@fcd04000 {
		compatible = "hisilicon,hi4511-dw-mshc";
		reg = <0xfcd04000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <0 17 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&mmc_clock HI3620_MMC_CIUCLK1>,
			 <&clock HI3620_DDRC_PER_CLK>;
		clock-names = "ciu", "biu";
		num-slots = <1>;
		fifo-depth = <0x100>;
		bus-width = <8>;
		non-removable;
		disable-wp;
		cap-mmc-highspeed;
		status = "okay";
	};
};

/* IOMG46 function 1 routes GPIO86/GPIO87 to I2C1 SCL/SDA. */
&pmx0 {
	i2c1_pins: i2c1-pins {
		pinctrl-single,pins = <
			0x0b8 0x1
		>;
	};

	/* Stock K3V2 iomux_pins.h says GPIO63/GPIO64 are I2C2 SCL/SDA on FUNC1. */
	i2c2_pins: i2c2-pins {
		pinctrl-single,pins = <
			0x068 0x1
			0x06c 0x1
		>;
	};
};

/*
 * GPIO156/GPIO157 are dedicated GPIO pads in Huawei's iomux database and do
 * not have IOMG selectors.  The generic hi3620.dtsi gpio-ranges table only
 * describes GPIO19 pins 0..3, so let PL061 own this bank directly.
 *
 * More importantly, the late diagnostic on the real tablet showed GPIO156
 * losing its output direction (dir changed from 0x12 to 0x02), which leaves
 * the Synaptics controller held in reset and turns the formerly hanging I2C2
 * bus into a clean NACK.  A GPIO hog is the right lifetime model here: the
 * stock RMI transport never owns the reset line itself, so keep reset high
 * for the whole boot after the early stock-style pulse in hi3620-touch-pad.c.
 */
&gpio19 {
	/delete-property/ gpio-ranges;

	touch_reset_hog: touch-reset-hog {
		gpio-hog;
		gpios = <4 0>;
		output-high;
		line-name = "touch-reset";
	};
};

&dual_timer0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};
